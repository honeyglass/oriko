{
  "name": "oriko",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Builds a two-column CV as .docx from a JSON master file and a profile per job posting.",
  "type": "module",
  "bin": {
    "oriko": "bin/oriko.ts"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 'tests/api/*.api.spec.ts' 'tests/internals/*.internals.spec.ts'",
    "typecheck": "tsc -p . --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "baselines:update": "node tools/baselines/update.ts",
    "baselines:gws": "node tools/baselines/gws.ts",
    "behavior:update": "node tests/utils/behavior.ts && prettier --write tests/fixtures/behavior.json",
    "readmes": "node tools/readmes/update.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@honeyglass/adx": "github:honeyglass/adx#13686037c70e114e3805868da7e126517a6f0832",
    "@honeyglass/utils": "github:honeyglass/utils#a6c8b941393ba0831b2909a54dae0a59d40f50bf",
    "docx": "9.15.3",
    "jpeg-js": "0.4.4",
    "jszip": "3.10.2",
    "parse5": "8.1.1",
    "pngjs": "7.0.0",
    "unpdf": "2.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "lint-staged": "17.6.0",
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.9.0+sha512.8f64efa0b792986ca98ae568791bcd7722807e274c4f0c1d9853c62116495c584119db98762a2a5343b1684d361b9ae26fdd16d551666d7635346d3fae830ddd",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
